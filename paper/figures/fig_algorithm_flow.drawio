art"><mxGeometry x="145" y="10" width="110" height="22" as="geometry"/></mxCell><mxCell id="c8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.3;fontSize=10.5;fontColor=#1A1A1A;fontFamily=Helvetica;" value="Construct initial solution &lt;i&gt;s&lt;/i&gt; by VAA"><mxGeometry x="93.0" y="58" width="214" height="34" as="geometry"/></mxCell><mxCell id="c9" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9DEE3;strokeColor=#4D4D4D;strokeWidth=1.3;fontSize=10.5;fontColor=#1A1A1A;fontFamily=Helvetica;" value="&lt;i&gt;s&lt;/i&gt; ← Descent(&lt;i&gt;s&lt;/i&gt;);&amp;nbsp; &lt;i&gt;s&lt;/i&gt;* ← &lt;i&gt;s&lt;/i&gt;&lt;br&gt;&lt;i&gt;c&lt;/i&gt; ← 0;&amp;nbsp; &lt;i&gt;n&lt;/i&gt; ← 1"><mxGeometry x="93.0" y="108" width="214" height="34" as="geometry"/></mxCell><mxCell id="c10" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.3;fontSize=10.5;fontColor=#1A1A1A;fontFamily=Helvetica;" value="Select operator uniformly&lt;br&gt;Generate candidate &lt;i&gt;s′&lt;/i&gt; from &lt;i&gt;s&lt;/i&gt;"><mxGeometry x="93.0" y="182" width="214" height="42" as="geometry"/></mxCell><mxCell id="c11" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9AA9B5;strokeColor=#4D4D4D;fontSize=9;fontColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;" value="Operator set Ω: 11 operators"><mxGeometry x="346" y="162" width="194" height="16" as="geometry"/></mxCell><mxCell id="c12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=9;fontColor=#1A1A1A;fontFamily=Helvetica;" value="7 generic: k1–k4, k6–k8&lt;br&gt;4 guided: g1–g4; each operator: 1/11"><mxGeometry x="346" y="178" width="194" height="28" as="geometry"/></mxCell><mxCell id="c13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#355C7D;strokeColor=#355C7D;strokeWidth=2.5;font