tica;" value="4 units"><mxGeometry x="140" y="334" width="58" height="26" as="geometry"/></mxCell><mxCell id="c43" parent="1" vertex="1" style="rounded=0;html=1;fillColor=#C9D8EA;strokeColor=#2F5D8A;strokeWidth=1.5;fontSize=9;fontColor=#222222;fontFamily=Helvetica;" value="freight for &lt;i&gt;d&lt;/i&gt;&lt;br&gt;waits for loading"><mxGeometry x="268" y="332" width="86" height="28" as="geometry"/></mxCell><mxCell id="c44" parent="1" edge="1" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#2F5D8A;strokeWidth=2.5;"><mxGeometry relative="1" as="geometry"><mxPoint x="458.0" y="148.0" as="sourcePoint"/><mxPoint x="318.8" y="333.6" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c45" parent="1" edge="1" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#2F5D8A;strokeWidth=2.5;"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="347" as="sourcePoint"/><mxPoint x="266" y="347" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c46" parent="1" edge="1" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;strokeWidth=1;dashed=1;dashPattern=4 3;"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="176" as="sourcePoint"/><mxPoint x="470" y="364" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c47" parent="1" edge="1" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;strokeWidth=1;dashed=1;dashPattern=4 3;"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="364" as="sourcePoint"/><mxPoint x="360" y="364" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c48" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#666666;fontStyle=0;fontFamily=Helvetica;" value="40"><mxGeometry x="474" y="282" width="30" height="14" as="geometry"/></mxCell><mxCell id="c49" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#666666;fontStyle=0;fontFamily=Helvetica;" value="30"><mxGeometry x="400" y="348" width="30" height="14" as="geometry"/></mxCell><mxCell id="c50" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#2F5D8A;fontStyle=0;fontFamily=Helvetica;" value="distance √(30² + 40²) = 50&lt;br&gt;&lt;b&gt;transfer time = 50/10 = 5&lt;/b&gt;"><mxGeometry x="140" y="222" width="212" height="30" as="geometry"/></mxCell><mxCell id="c51" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#2F5D8A;fontStyle=0;fontFamily=Helvetica;" value="distance 20&lt;br&gt;&lt;b&gt;transfer time = 20/10 = 2&lt;/b&gt;"><mxGeometry x="162" y="288" width="200" height="30" as="geometry"/></mxCell><mxCell id="c52" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#666666;fontStyle=2;fontFamily=Helvetica;" value="Direct transfer: freight goes straight from the source door to the carrier's door. The transfer time is the door distance divided by 10."><mxGeometry x="118" y="158" width="190" height="40" as="geometry"/></mxCell><mxCell id="c53" parent="1" vertex="1" style="line;strokeColor=#CCCCCC;strokeWidth=1;html=1;" value=""><mxGeometry x="10" y="498" width="580" height="2" as="geometry"/></mxCell><mxCell id="c54" parent="1" vertex="1" style="rounded=0;html=1;fillColor=#C9D8EA;strokeColor=#2F5D8A;dashed=1;dashPattern=3 2;" value=""><mxGeometry x="10" y="508" width="20" height="13" as="geometry"/></mxCell><mxCell id="c55" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#222222;fontStyle=0;fontFamily=Helvetica;" value="freight for &lt;i&gt;d&lt